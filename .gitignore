# Environment
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/

# Competition data must never be committed (rules: no redistribution)
data/
*.parquet
*.npy
*.npz
*.memmap
*.bin
submission*.csv

# Large build artifacts
artifacts/
runs/*
!runs/.gitkeep

# Never commit Kaggle authentication or local secret files
.env
.env.*
!.env.example
.kaggle/
kaggle.json
access_token

# Local publication readbacks and execution logs
runs/kaggle-*/
.artifacts/
